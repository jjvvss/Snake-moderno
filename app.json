{
  "expo": {
    "name": "Neon Snake",
    "slug": "snake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.neonsnake.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.neonsnake.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "baseUrl": "/Snake-moderno"
    },
    "plugins": [
      "expo-av",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "b657f2df-6c8b-4e72-add5-62198e0800c8"
      }
    },
    "owner": "jorge0000"
  }
}
